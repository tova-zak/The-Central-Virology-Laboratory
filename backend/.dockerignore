# Exclude sensitive and unnecessary files from Docker build

# Environment files
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Storage (ephemeral, will be created at runtime)
temp_storage/
*.json

# Logs
*.log

# Git
.git/
.gitignore
.gitattributes

# IDE
.vscode/
.idea/
*.swp
*.swo

# Documentation (not needed in runtime image)
tests/
docs/
*.md
!README.md

# Build artifacts
dist/
build/
*.egg-info/
