# ============================================
# Gemini API Configuration
# ============================================

# Get your free API key from: https://aistudio.google.com/apikey

# Primary API key (required)
GEMINI_API_KEY=your-primary-gemini-api-key-here

# Additional API keys for load balancing (optional, up to 8 more)
# All keys should belong to the same Google Cloud project (shared quota)
# Duplicates are automatically detected and skipped
# Leave empty if not using multiple keys
GEMINI_API_1=
GEMINI_API_2=
GEMINI_API_3=
GEMINI_API_4=
GEMINI_API_5=
GEMINI_API_6=
GEMINI_API_7=
GEMINI_API_8=

# Model Selection
# Updated to gemini-1.5-flash (stable verified working model, Oct 2026)
# Previous gemini-2.0-flash-exp was shut down June 1, 2026
# Other free options: gemini-3.6-flash, gemini-3.5-flash-lite, gemini-2.5-flash
GEMINI_MODEL=gemini-1.5-flash

# Free Tier Limits (per project, shared across all keys):
# IMPORTANT: Limits vary by model and account. These are for gemini-1.5-flash.
# Always verify your actual limits at: https://aistudio.google.com/
# - 15 requests/minute (RPM)
# - 1500 requests/day (RPD)
# - 1,000,000 tokens/day

# ============================================
# Demo Mode
# ============================================

# DEMO_MODE=true  -> Uses MockExtractor, 0 API calls, 0 cost
# DEMO_MODE=false -> Uses real Gemini API (respects quota limits)
# WARNING: Only use DEMO_MODE=true in development/testing, not with real patient data
DEMO_MODE=false

# ============================================
# Hybrid Extraction Engine (Experimental)
# ============================================

# Master switch - set to true to enable full pipeline
# Pipeline: Image Preprocessing → Gemini Vision → Tesseract OCR → Hybrid Verification
# When false: uses baseline Gemini-only extraction
HYBRID_ENGINE_ENABLED=false

# Individual layer controls (only apply if HYBRID_ENGINE_ENABLED=true)
ENABLE_PREPROCESSING=true      # Image rotation, deskew, contrast enhancement
ENABLE_OCR=true                # Tesseract OCR verification layer
ENABLE_HYBRID_VERIFICATION=true # Cross-check Gemini vs OCR results
ENABLE_FOCUSED_RETRY=false     # DISABLED by default, requires explicit approval

# ============================================
# Tesseract OCR Configuration (Optional)
# ============================================

# Path to Tesseract executable (only if not in PATH)
# Windows example: D:\Users\1\tesseract.exe
# Linux/Mac: usually in PATH, leave empty
# TESSERACT_CMD=

# Tesseract will be auto-detected if in PATH
# If OCR fails, check logs for "TesseractNotFoundError"

# File Processing Limits
# MAX_UPLOAD_SIZE_MB=20
# MAX_PAGES_PER_PDF=30
# MAX_BATCH_SIZE=10
# STORAGE_TTL_HOURS=24

# CORS Configuration (comma-separated origins)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
